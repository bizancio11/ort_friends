import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models

# 1. DATOS DE ENTRENAMIENTO (Estructura de un solo archivo)
data = {
    "intents": [
        {"tag": "saludo", "patterns": ["hola", "buen dia", "hey", "hola como estas"], 
         "responses": ["¡Hola!", "Hola, ¿en qué puedo ayudarte?"]},
        {"tag": "despedida", "patterns": ["adios", "chao", "nos vemos", "hasta luego"], 
         "responses": ["¡Hasta luego!", "Cuídate mucho."]},
        {"tag": "nombre", "patterns": ["como te llamas", "quien eres", "cual es tu nombre"], 
         "responses": ["Soy un bot creado con Keras.", "Me llaman ChatBot-Py."]}
    ]
}

# 2. PREPROCESAMIENTO DE TEXTO
words = []
classes = []
documents = []

for intent in data['intents']:
    for pattern in intent['patterns']:
        # Tokenización simple
        w = pattern.lower().split()
        words.extend(w)
        documents.append((w, intent['tag']))
        if intent['tag'] not in classes:
            classes.append(intent['tag'])

words = sorted(list(set(words)))
classes = sorted(list(set(classes)))

# Crear bolsa de palabras (Bag of Words)
training = []
output_empty = [0] * len(classes)

for doc in documents:
    bag = []
    pattern_words = doc[0]
    for w in words:
        bag.append(1) if w in pattern_words else bag.append(0)
    
    output_row = list(output_empty)
    output_row[classes.index(doc[1])] = 1
    training.append([bag, output_row])

training = np.array(training, dtype=object)
train_x = np.array(list(training[:, 0]))
train_y = np.array(list(training[:, 1]))

# 3. DISEÑO Y ENTRENAMIENTO DEL MODELO
model = models.Sequential([
    layers.Dense(128, input_shape=(len(train_x[0]),), activation='relu'),
    layers.Dropout(0.5),
    layers.Dense(64, activation='relu'),
    layers.Dropout(0.5),
    layers.Dense(len(train_y[0]), activation='softmax')
])

model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
print("Entrenando...")
model.fit(train_x, train_y, epochs=200, batch_size=5, verbose=0)
print("Entrenamiento completado.")

# 4. LÓGICA DEL CHATBOT
def clean_up_sentence(sentence):
    return sentence.lower().split()

def bow(sentence, words):
    sentence_words = clean_up_sentence(sentence)
    bag = [0]*len(words)
    for s in sentence_words:
        for i,w in enumerate(words):
            if w == s: bag[i] = 1
    return np.array(bag)

def predict_class(sentence):
    p = bow(sentence, words)
    res = model.predict(np.array([p]), verbose=0)[0]
    # Umbral de probabilidad
    ERROR_THRESHOLD = 0.25
    results = [[i,r] for i,r in enumerate(res) if r > ERROR_THRESHOLD]
    results.sort(key=lambda x: x[1], reverse=True)
    return classes[results[0][0]]

def get_response(tag):
    for i in data['intents']:
        if i['tag'] == tag:
            return np.random.choice(i['responses'])

# Iniciar conversación
print("\n¡Bot listo! (escribe 'salir' para finalizar)")
while True:
    message = input("Tú: ")
    if message.lower() == "salir": break
    
    intent_tag = predict_class(message)
    response = get_response(intent_tag)
    print(f"Bot: {response}")
