import json
import random
import re
import urllib.request
import urllib.error

DEFAULT_DATA_URL = "https://raw.githubusercontent.com/b izancio11/ort_friends/main/intents.json"


def carga_intents_desde_url(url):
    try:
        with urllib.request.urlopen(url, timeout=10) as response:
            if response.status != 200:
                raise ValueError(f"Servidor respondió con código {response.status}")
            contenido = response.read().decode("utf-8")
            datos = json.loads(contenido)
    except urllib.error.URLError as err:
        print(f"No se pudo conectar a internet: {err}")
        return None
    except ValueError as err:
        print(f"Error al procesar los datos remotos: {err}")
        return None
    except Exception as err:
        print(f"Error inesperado al cargar datos remotos: {err}")
        return None

    if isinstance(datos, dict) and "intents" in datos:
        return datos["intents"]
    if isinstance(datos, list):
        return datos

    print("Los datos remotos no están en el formato esperado.")
    return None


